# Configuração do dotboot. Todas as variáveis são opcionais.
#
# O sítio normal para isto é ~/.config/dotboot/config.env (é esse que a TUI
# edita em Definições e que o `make config` cria). Um .env no diretório
# atual também é lido, e as variáveis de ambiente têm sempre prioridade.

# Pasta base dos downloads e dos stems (default: o diretório atual). Usada
# quando -o não é passado; um -o relativo (ex: -o musica) fica dentro dela, e
# um -o absoluto ignora-a. O ~ é expandido.
#DOTBOOT_OUTPUT_DIR=~/Videos

# Cookies de um browser com sessão iniciada, em formato Netscape (exporta-os
# com uma extensão como "Get cookies.txt LOCALLY"). Resolvem a verificação
# "confirma que não és um robô" do YouTube, a restrição de idade e o
# conteúdo que pede login.
#DOTBOOT_COOKIES_FILE=~/cookies.txt

# Pasta dos modelos da separação de stems, descarregados na primeira
# utilização de cada um (~/.cache/dotboot/models; no Docker, o volume
# dotboot-models).
#DOTBOOT_MODELS_DIR=~/.cache/dotboot/models

# Pasta do trabalho intermédio dos stems (default do sistema).
#DOTBOOT_TEMP_DIR=/tmp

# Runtime JavaScript que o yt-dlp usa para os desafios do YouTube. Vazio usa
# o Deno (incluído na imagem Docker; make deps instala-o) ou, sem ele, o node.
#DOTBOOT_JS_RUNTIMES=node

# Verbosidade dos logs dos subcomandos: debug | info | warn | error (info).
#DOTBOOT_LOG_LEVEL=info
