# Configuração do dotboot. Todas as variáveis são opcionais.
#
# Para a instalação nativa, o sítio normal para isto é
# ~/.config/dotboot/config.env. Um .env no diretório atual também é lido, e
# as variáveis de ambiente têm sempre prioridade. Com o wrapper Docker
# (dotboot), passam-se como variáveis de ambiente: DOTBOOT_PORT,
# DOTBOOT_COOKIES_FILE, DOTBOOT_LOG_LEVEL e DOTBOOT_JS_RUNTIMES.

# Onde o servidor escuta (default 127.0.0.1:8765: só este computador).
#DOTBOOT_ADDR=127.0.0.1:8765

# Pasta de dados: as separações (o estúdio), os vídeos e as músicas
# descarregados e os ficheiros enviados. Nada sai daqui sem o descarregares
# pelo browser. No Docker é o volume dotboot-data.
#DOTBOOT_DATA_DIR=~/.local/share/dotboot

# Cookies de um browser com sessão iniciada, em formato Netscape (exporta-os
# com uma extensão como "Get cookies.txt LOCALLY"). Resolvem a verificação
# "confirma que não és um robô" do YouTube, a restrição de idade e o
# conteúdo que pede login. Também se podem enviar pela página (Definições).
#DOTBOOT_COOKIES_FILE=~/cookies.txt

# Pasta dos modelos da separação, descarregados na primeira utilização de
# cada um (~/.cache/dotboot/models; no Docker, o volume dotboot-models).
#DOTBOOT_MODELS_DIR=~/.cache/dotboot/models

# Pasta do trabalho intermédio da separação e das exportações (default do
# sistema).
#DOTBOOT_TEMP_DIR=/tmp

# Runtime JavaScript que o yt-dlp usa para os desafios do YouTube. Vazio usa
# o Deno (incluído na imagem Docker; make deps instala-o) ou, sem ele, o node.
#DOTBOOT_JS_RUNTIMES=node

# Verbosidade do log do servidor: debug | info | warn | error (info).
#DOTBOOT_LOG_LEVEL=info
