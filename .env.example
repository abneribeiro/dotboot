# Discord Bot Configuration Template
# Copy this file to .env and fill in your actual values

# Discord Bot Token (obrigatório apenas para o subcomando "bot")
# Get your token from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# ---------------------------------------------------------------
# Configuração opcional (defaults entre parênteses)
# ---------------------------------------------------------------

# Registo do slash command apenas neste servidor, com propagação instantânea
# (útil em desenvolvimento). Vazio = registo global, que pode demorar até
# 1 hora a propagar. Só se aplica ao subcomando "bot".
#DOTBOOT_GUILD_ID=

# TETO opcional para o upload do bot, em MB. Por omissão não há teto: o bot
# usa o que o Discord permite no servidor onde o comando corre — 20MB sem
# boost ou no Nível 1, 50MB no Nível 2, 100MB no Nível 3. Definir esta
# variável só BAIXA esse limite (útil para poupar largura de banda); nunca o
# aumenta, porque o Discord recusaria o upload à mesma.
# Não se aplica ao modo CLI.
#DOTBOOT_MAX_FILE_SIZE_MB=

# Timeout de cada download do bot, sintaxe Go (10m). Não se aplica ao modo CLI.
#DOTBOOT_DOWNLOAD_TIMEOUT=10m

# Downloads simultâneos no bot (3).
#DOTBOOT_MAX_CONCURRENT=3

# Tempo de espera por downloads em curso no encerramento (30s).
#DOTBOOT_SHUTDOWN_GRACE=30s

# Caminho base de saída do modo CLI (diretório atual). Usado quando -o não é
# passado; um -o relativo (ex: -o musica) é criado dentro dele, e um -o
# absoluto ignora-o. O ~ é expandido (ex: ~/Videos).
# Não afeta o bot Discord, que usa apenas DOTBOOT_TEMP_DIR.
#DOTBOOT_OUTPUT_DIR=/home/user/Videos

# Diretório de ficheiros temporários do bot (default do sistema).
#DOTBOOT_TEMP_DIR=/tmp

# Verbosidade dos logs: debug | info | warn | error (info).
#DOTBOOT_LOG_LEVEL=info

# Cookies de um browser com sessão iniciada, em formato Netscape (exporta-os
# com uma extensão como "Get cookies.txt LOCALLY"). Resolvem a verificação
# "confirma que não és um robô" do YouTube — frequente em servidores —, a
# restrição de idade e o conteúdo que pede login. Usados pelo bot e pela CLI.
#DOTBOOT_COOKIES_FILE=/home/user/cookies.txt

# Runtime JavaScript que o yt-dlp usa para os desafios do YouTube. Vazio usa o
# Deno (incluído na imagem Docker; make deps instala-o no host) ou, sem ele,
# o node. Só precisas de mexer aqui para forçar outro.
#DOTBOOT_JS_RUNTIMES=node

# Downloads simultâneos (em curso ou na fila) de cada utilizador do bot (2).
#DOTBOOT_MAX_PER_USER=2

# Limita o bot a estes domínios e aos seus subdomínios, separados por
# vírgulas. Vazio = qualquer site público (endereços da rede local são sempre
# recusados). Só se aplica ao bot.
#DOTBOOT_ALLOWED_DOMAINS=youtube.com,youtu.be,x.com,twitter.com,instagram.com,tiktok.com

# Pasta dos modelos da separação de stems (dotboot stems), descarregados na
# primeira utilização de cada um (~/.cache/dotboot/models).
#DOTBOOT_MODELS_DIR=/home/user/.cache/dotboot/models
