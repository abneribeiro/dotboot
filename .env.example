# Discord Bot Configuration Template
# Copy this file to .env and fill in your actual values

# Discord Bot Token (obrigatório apenas para o subcomando "bot")
# Get your token from: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# ---------------------------------------------------------------
# Configuração opcional (defaults entre parênteses)
# ---------------------------------------------------------------

# Limite de upload do Discord em MB (25). Não se aplica ao modo CLI.
#DOTBOOT_MAX_FILE_SIZE_MB=25

# Timeout de cada download do bot, sintaxe Go (10m). Não se aplica ao modo CLI.
#DOTBOOT_DOWNLOAD_TIMEOUT=10m

# Downloads simultâneos no bot (3).
#DOTBOOT_MAX_CONCURRENT=3

# Tempo de espera por downloads em curso no encerramento (30s).
#DOTBOOT_SHUTDOWN_GRACE=30s

# Caminho base de saída do modo CLI (diretório atual). Usado quando -o não é
# passado; um -o relativo (ex: -o musica) é criado dentro dele, e um -o
# absoluto ignora-o. Usa um caminho absoluto — o ~ não é expandido aqui.
# Não afeta o bot Discord, que usa apenas DOTBOOT_TEMP_DIR.
#DOTBOOT_OUTPUT_DIR=/home/user/Videos

# Diretório de ficheiros temporários do bot (default do sistema).
#DOTBOOT_TEMP_DIR=/tmp

# Verbosidade dos logs: debug | info | warn | error (info).
#DOTBOOT_LOG_LEVEL=info
