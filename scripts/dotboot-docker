#!/usr/bin/env bash
# dotboot (via Docker) — corre o dotboot dentro de um container, sem yt-dlp,
# ffmpeg, deno nem audio-separator no host. `make install-docker` instala-o
# no PATH com o nome "dotboot".
#
#   dotboot                         abre a TUI
#   dotboot <url>                   igual a "dotboot download <url>"
#   dotboot download -o aulas <url>
#   dotboot stems ~/Musica/song.mp3
#
# O container corre com o teu utilizador e com a tua home montada no mesmo
# caminho: o ~, os caminhos absolutos, o ~/.config/dotboot e o seletor de
# ficheiros da TUI funcionam como na instalação nativa. Os modelos dos stems
# ficam no volume "dotboot-models".
#
# Variáveis: DOTBOOT_IMAGE (default dotboot:latest) e as DOTBOOT_* do dotboot.
set -euo pipefail

image=${DOTBOOT_IMAGE:-dotboot:latest}

# Aceita "dotboot <url>" como atalho de "dotboot download <url>".
case "${1:-}" in
"" | tui | download | stems | doctor | version | help | -h | --help | -v | --version) ;;
*) set -- download "$@" ;;
esac

docker_args=(run --rm -i --init
	--user "$(id -u):$(id -g)"
	-e HOME="$HOME"
	-v "$HOME:$HOME"
	-v dotboot-models:/models
	-w "$PWD")

# A TUI precisa de um terminal; as cores, de saber qual é.
if [ -t 0 ] && [ -t 1 ]; then
	docker_args+=(-t -e TERM="${TERM:-xterm-256color}")
	if [ -n "${COLORTERM:-}" ]; then
		docker_args+=(-e COLORTERM="$COLORTERM")
	fi
fi

# mount_same monta um caminho do host no mesmo sítio dentro do container,
# a não ser que já esteja dentro da home (que já está montada).
mounted=$'\n'
mount_same() {
	local path=$1
	case "$path" in "$HOME" | "$HOME"/*) return ;; esac
	case "$mounted" in *$'\n'"$path"$'\n'*) return ;; esac
	docker_args+=(-v "$path:$path")
	mounted+="$path"$'\n'
}

mount_same "$PWD"

# As variáveis do dotboot definidas no host valem também lá dentro.
for var in DOTBOOT_OUTPUT_DIR DOTBOOT_COOKIES_FILE DOTBOOT_LOG_LEVEL DOTBOOT_JS_RUNTIMES; do
	if [ -n "${!var:-}" ]; then
		docker_args+=(-e "$var=${!var}")
	fi
done

# config_value lê KEY de um ficheiro .env (a última linha ganha), sem aspas.
config_value() {
	local key=$1 file=$2 line value=""
	[ -r "$file" ] || return 0
	while IFS= read -r line || [ -n "$line" ]; do
		case "$line" in "$key="*) value=${line#*=} ;; esac
	done <"$file"
	case "$value" in \"*\") value=${value:1:-1} value=${value//\\\"/\"} value=${value//\\\\/\\} ;; esac
	# shellcheck disable=SC2088 # o ~ é literal: expande-se aqui à mão
	case "$value" in "~" | "~/"*) value=$HOME${value:1} ;; esac
	printf '%s' "$value"
}

# setting devolve uma definição com a prioridade do dotboot: ambiente,
# ./.env e por fim ~/.config/dotboot/config.env.
config_file=${XDG_CONFIG_HOME:-$HOME/.config}/dotboot/config.env
setting() {
	local key=$1 value=${!1:-}
	[ -n "$value" ] || value=$(config_value "$key" .env)
	[ -n "$value" ] || value=$(config_value "$key" "$config_file")
	printf '%s' "$value"
}

# A pasta de saída e a dos cookies, venham de onde vierem, têm de estar
# montadas: sem isto, a pasta gravada nas Definições não existia no container.
output=$(setting DOTBOOT_OUTPUT_DIR)
if [ -n "$output" ] && mkdir -p "$output" 2>/dev/null; then
	mount_same "$(cd "$output" && pwd)"
fi
cookies=$(setting DOTBOOT_COOKIES_FILE)
if [ -n "$cookies" ] && [ -e "$cookies" ]; then
	mount_same "$(cd "$(dirname "$cookies")" && pwd)"
fi

# No WSL, os discos do Windows (/mnt/c, /mnt/d…): uma pasta escrita na TUI
# depois de o container arrancar já não pode ser montada.
if grep -qi microsoft /proc/version 2>/dev/null; then
	for drive in /mnt/[a-z]; do
		if [ -d "$drive" ]; then
			mount_same "$drive"
		fi
	done
fi

# Caminhos absolutos nos argumentos (-o, -a, -cookies, ficheiros de música).
prev=""
for arg in "$@"; do
	value=$arg
	case "$arg" in -o=* | -a=* | -cookies=*) value=${arg#*=} ;; esac
	case "$value" in
	/*)
		if [ "$prev" = "-o" ] || [ "${arg%%=*}" = "-o" ]; then
			mkdir -p "$value"
			mount_same "$value"
		elif [ -e "$value" ]; then
			mount_same "$(dirname "$value")"
		fi
		;;
	esac
	prev=$arg
done

exec docker "${docker_args[@]}" "$image" "$@"
