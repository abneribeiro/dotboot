#!/usr/bin/env bash
# dotboot (via Docker) — corre o dotboot dentro de um container, sem yt-dlp,
# ffmpeg, deno nem audio-separator no host. `make install-docker` instala-o
# no PATH com o nome "dotboot".
#
#   dotboot                         abre a TUI
#   dotboot <url>                   igual a "dotboot download <url>"
#   dotboot download -o aulas <url>
#   dotboot stems ~/Musica/song.mp3
#
# O container corre com o teu utilizador e com a tua home montada no mesmo
# caminho: o ~, os caminhos absolutos, o ~/.config/dotboot e o seletor de
# ficheiros da TUI funcionam como na instalação nativa. Os modelos dos stems
# ficam no volume "dotboot-models".
#
# Variáveis: DOTBOOT_IMAGE (default dotboot:latest) e as DOTBOOT_* do dotboot.
set -euo pipefail

image=${DOTBOOT_IMAGE:-dotboot:latest}

# Aceita "dotboot <url>" como atalho de "dotboot download <url>".
case "${1:-}" in
"" | tui | download | stems | doctor | version | help | -h | --help | -v | --version) ;;
*) set -- download "$@" ;;
esac

docker_args=(run --rm -i --init
	--user "$(id -u):$(id -g)"
	-e HOME="$HOME"
	-v "$HOME:$HOME"
	-v dotboot-models:/models
	-w "$PWD")

# A TUI precisa de um terminal; as cores, de saber qual é.
if [ -t 0 ] && [ -t 1 ]; then
	docker_args+=(-t -e TERM="${TERM:-xterm-256color}")
	if [ -n "${COLORTERM:-}" ]; then
		docker_args+=(-e COLORTERM="$COLORTERM")
	fi
fi

# mount_same monta um caminho do host no mesmo sítio dentro do container,
# a não ser que já esteja dentro da home (que já está montada).
mounted=$'\n'
mount_same() {
	local path=$1
	case "$path" in "$HOME" | "$HOME"/*) return ;; esac
	case "$mounted" in *$'\n'"$path"$'\n'*) return ;; esac
	docker_args+=(-v "$path:$path")
	mounted+="$path"$'\n'
}

mount_same "$PWD"

# As variáveis do dotboot definidas no host valem também lá dentro.
for var in DOTBOOT_OUTPUT_DIR DOTBOOT_COOKIES_FILE DOTBOOT_LOG_LEVEL DOTBOOT_JS_RUNTIMES; do
	if [ -n "${!var:-}" ]; then
		docker_args+=(-e "$var=${!var}")
		case "$var" in
		DOTBOOT_OUTPUT_DIR)
			mkdir -p "${!var}"
			mount_same "$(cd "${!var}" && pwd)"
			;;
		DOTBOOT_COOKIES_FILE) mount_same "$(cd "$(dirname "${!var}")" && pwd)" ;;
		esac
	fi
done

# Caminhos absolutos nos argumentos (-o, -a, -cookies, ficheiros de música).
prev=""
for arg in "$@"; do
	value=$arg
	case "$arg" in -o=* | -a=* | -cookies=*) value=${arg#*=} ;; esac
	case "$value" in
	/*)
		if [ "$prev" = "-o" ] || [ "${arg%%=*}" = "-o" ]; then
			mkdir -p "$value"
			mount_same "$value"
		elif [ -e "$value" ]; then
			mount_same "$(dirname "$value")"
		fi
		;;
	esac
	prev=$arg
done

exec docker "${docker_args[@]}" "$image" "$@"
